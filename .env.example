POSTGRES_USER=dramafy
POSTGRES_PASSWORD=dramafy
POSTGRES_DB=dramafy
POSTGRES_PORT=5434
API_PORT=8000
# Scrape once when the API starts, then every N hours (0 = only on demand via POST /scrape)
SCRAPE_ON_STARTUP=true
SCRAPE_INTERVAL_HOURS=24
SCRAPE_CONCURRENCY=8
# archive.org collections to scrape, as collection:Category pairs (category is stored on each show)
ARCHIVE_COLLECTIONS=oldtimeradio:Old Time Radio,librivoxaudio:Audiobooks
# Most-downloaded items first, per collection; 0 = every item (~9k radio sets + ~22k audiobooks)
ARCHIVE_MAX_ITEMS_PER_COLLECTION=2000
# LearnOutLoud sections to scrape, as section:Category pairs
LEARNOUTLOUD_SECTIONS=Free-Audiobooks:Audiobooks,Podcast-Directory:Podcasts,Free-Courses:Courses
# First N titles (A-Z) per section; 0 = every title
LEARNOUTLOUD_MAX_ITEMS_PER_SECTION=0
# Transcripts (episode text). Workers transcribing at once (each uses several CPU cores); 0 = off
TRANSCRIBE_WORKERS=1
# faster-whisper model: tiny | base | small | medium | large-v3. Downloaded on first use into the whisper-models volume
WHISPER_MODEL=small
# cpu, or cuda with an NVIDIA GPU (then WHISPER_COMPUTE_TYPE=float16)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# CPU threads per worker; 0 = default
WHISPER_CPU_THREADS=0
TRANSCRIBE_MAX_AUDIO_MB=500
# Queue every episode of these platforms after each scrape, e.g. parrotfm,dramafy (empty = only on request)
TRANSCRIBE_AUTO_PLATFORMS=
